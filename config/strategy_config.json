  "candidate_filters": {
    "conditions": [
      {
        "column": "segment_limit_up_count_bucket",
        "operator": "==",
        "value": "lt_5",
        "description": "所属市场分段涨停数量小于5，偏冰点/低热度环境。"
      },
      {
        "column": "market_chain_count_bucket",
        "operator": "==",
