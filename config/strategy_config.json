      },
      {
        "column": "fd_ratio_bucket",
        "operator": "==",
        "value": "0_5pct_1pct",
        "description": "封单金额/流通市值在0.5%-1%，避免过弱和过强的一字不可成交状态。"
      }
    ],
    "exclude_conditions": [
      {
        "column": "amount_ratio_bucket",
        "operator": "==",
        "value": "0_8_1_2",
