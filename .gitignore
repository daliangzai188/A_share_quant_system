data/raw/*
!data/raw/daily/
!data/raw/daily_basic/
!data/raw/limit_list/
data/raw/trade_calendar.csv
data/raw/daily/*.csv
data/raw/daily_basic/*.csv
data/raw/limit_list/*.csv
!data/raw/daily/.gitkeep
!data/raw/daily_basic/.gitkeep
!data/raw/limit_list/.gitkeep
data/processed/*
!data/processed/.gitkeep
# POV守护进程的本地执行账本，包含委托号并用于防止重复分片下单，禁止入库
data/state/
data/database/*
!data/database/.gitkeep

# OS and editor files
.DS_Store
.idea/
.vscode/
reports/paper_trade/batch_flow/*.csv
reports/paper_trade/ab_filtered_daily_ops/*.csv

# 守护进程运行时 PID 文件
.daemon_pid
.watchdog_pid
.keeper_pid

# 临时安装包
*.exe
*.msi

# QMT 运行时生成文件
reports/live_trade/qmt_path_candidates.txt
reports/live_trade/qmt_live_readiness.csv
reports/live_trade/qmt_live_readiness.md

# Syncthing
.stfolder/
.sync-conflict-*

# 策略信号运行状态账本（每日流水线自动重写，无版本控制价值）
reports/**/*signal_runs_recent.json
reports/strategy_m/m_equity_peak.json

# 本地成交审计与滚动分析产物：包含真实成交明细或会被每日任务覆盖，只保留在本机
reports/execution_tracking/*.json
reports/july_august_review/*.json
reports/live_performance/*.json
reports/oos_evaluation/*.json
reports/release_guard/
reports/account_risk_shadow/
reports/account_risk_research/
reports/account_risk_robustness/

# 实盘运行状态备份包含持仓、委托号和成交事件，只保留本机/异地备份，禁止入库
backups/runtime_state/
reports/runtime_state_backup/

# Windows/Mac运行守护状态由本机定时任务持续覆盖，包含本机路径和任务状态
reports/runtime/
