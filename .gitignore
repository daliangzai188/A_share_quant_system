# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example

# Runtime logs
logs/*
!logs/.gitkeep
*.log

# Generated reports
reports/*.csv
reports/*.xlsx
reports/**/*.csv
reports/**/*.xlsx
reports/**/*.md
data/state/open_plan_push.json
reports/strategy_health/state.json
reports/strategy_e2/e2_signals_recent.json
reports/strategy_l/l_signals_recent.json
