# 复制本文件为 .env，并填入你自己的 Tushare Pro Token。
# 不要把真实 Token 提交到 Git。
TUSHARE_TOKEN=your_tushare_pro_token_here

# 可选：覆盖默认日志级别，例如 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 新 Windows 使用完整 QMT 内置 Python；凭据先按本机填写，首次部署保持只读。
# 不要把真实账号提交到公开仓库；如果必须跨电脑同步，请确认仓库权限和电脑安全。
QMT_ACCOUNT_ID=your_qmt_account_id_here
QMT_ACCOUNT_TYPE=STOCK
QMT_PATH=C:/QMT/GJQMT/userdata
# 此路径是 2026-10 新机现场值，安装到其他目录时改为实际 userdata 路径。
# 券商接口：qmt_inner（本次已验证方案）；miniqmt 仅用于旧接口。
# qmt_inner 不要求外部 Python 安装 xtquant，不用设置 QMT_SESSION_ID。
QMT_TRANSPORT=qmt_inner
# 旧 miniQMT 接口使用时才填写：QMT_SESSION_ID=1001
# 内置配置默认位于 Windows LOCALAPPDATA/A_System/qmt_inner/config.json。
# QMT_INNER_CONFIG=

# 可选：Bark 实盘告警推送地址（iPhone Bark App 首页的 URL，形如 https://api.day.app/<DeviceKey>）。
# 不配置则不推送，只记日志。正文：账号仅后2位、金额用万单位、含标的代码名称。
BARK_URL=https://api.day.app/your_bark_device_key
